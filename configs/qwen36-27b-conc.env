# Qwen3.6-27B-FP8 — base champion + concurrency headroom at the PRODUCTION-LEAN footprint.
# util 0.04 = 7.3GB/card (SAME as the deployed base champion; co-resides with GLM) but max-num-seqs 64
# (max-num-seqs is FREE — it doesn't grow the util-sized pool). This measures the REAL concurrency the
# DEPLOYABLE lean config sustains, and where (if anywhere) the lean KV pool (474 blocks = 60,672 token-
# slots) starts to starve at high concurrency × context. dynamic_shapes DEFAULT (dynamic ON = one graph
# spans bs, smooth at concurrency). (An earlier util 0.5 = 46GB run gave the ceiling: c16 390 / c32 716
# decode — NOT deployable, discarded.) GOAL: c8/c16/c32/c64 at 7.3GB.
IMAGE=vllm-gaudi:next
MODEL_PATH=Qwen3.6-27B-FP8
SERVED_NAME=qwen36-27b
MODEL_ENV="-e PT_HPU_LAZY_MODE=0 -e PT_HPU_WEIGHT_SHARING=0 -e VLLM_SKIP_WARMUP=true -e VLLM_ENGINE_ITERATION_TIMEOUT_S=1800 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 -e VLLM_DECODE_BS_BUCKET_MIN=1 -e VLLM_GRAPH_RESERVED_MEM=0.10 -e VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true"
VLLM_ARGS="--quantization fp8 --kv-cache-dtype fp8_inc --tensor-parallel-size 8 --max-model-len 2048 --max-num-seqs 64 --gpu-memory-utilization 0.04 --block-size 128 --async-scheduling --no-enable-prefix-caching --trust-remote-code"
