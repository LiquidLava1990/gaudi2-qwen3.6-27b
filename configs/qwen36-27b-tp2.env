# Qwen3.6-27B-FP8 — TP=2 SS lever test (fewer collectives). Clean isolation vs the 39.1 SS champion:
# BOTH have dynamic_shapes=false + eager; ONLY tensor-parallel-size changes (8 -> 2). TP=8 pays an 8-way
# all-reduce x2/layer x64 layers/token; TP=2 pays a 2-way (fewer hops, less sync) at the cost of 4x more
# compute/card + 4x bigger weight shard (15.5GB/card). On a SMALL 31GB model the collective/host overhead
# may dominate -> TP=2 could beat TP=8 on SS. Uses 2 of 8 cards (6 idle) = a Qwen-DEDICATED profile, NOT
# co-resident with GLM (that needs TP=8 symmetry). util 0.25 (~24GB: 15.5 weights + pool). GATE: coherent
# + SS c1 vs the 39.1 TP=8 dynshapes champion. If big -> a real Qwen-dedicated SS option to offer.
IMAGE=vllm-gaudi:next
MODEL_PATH=Qwen3.6-27B-FP8
SERVED_NAME=qwen36-27b
MODEL_ENV="-e PT_HPU_LAZY_MODE=0 -e PT_HPU_WEIGHT_SHARING=0 -e VLLM_SKIP_WARMUP=true -e VLLM_T_COMPILE_DYNAMIC_SHAPES=false -e VLLM_ENGINE_ITERATION_TIMEOUT_S=1800 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 -e VLLM_GRAPH_RESERVED_MEM=0.10 -e VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true"
VLLM_ARGS="--quantization fp8 --kv-cache-dtype fp8_inc --tensor-parallel-size 2 --max-model-len 2048 --max-num-seqs 16 --gpu-memory-utilization 0.25 --block-size 128 --async-scheduling --no-enable-prefix-caching --trust-remote-code"
