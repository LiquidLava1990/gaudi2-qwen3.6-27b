# =================================================================================================
# Qwen3.6-27B CO-RESIDENT (under GLM-5.2) — lean, fp8_inc KV, APC on. Pair with glm52-coresident-offload.env
# =================================================================================================
# Spec (NOT yet served — validate on-box). Derived from qwen36-27b.env. Qwen's footprint is NOT
# context/KV-bound: it is the GatedDeltaNet (Mamba2) recurrent STATE pool, which is UTIL-SIZED and
# O(1) in context (a paused agent's Qwen state is a fixed page, not a growing KV run). So:
#   * fp8_inc KV      — kept, but attn-KV is ~0.3% of Qwen's footprint (16 full-attn layers). Lossless.
#   * --enable-prefix-caching — ON. Helps the 16 full-attn layers reuse shared system-prompt KV.
#                       CAVEAT: Qwen is HYBRID → platform.py:214 auto-overrides mamba_cache_mode
#                       'all'->'align' under APC (block-aligned chunked-prefill). No contiguous-PA
#                       (APC-exclusive). GDN state itself is not APC-dedupable — modest APC benefit.
#   * NO CPU offload connector — the GDN state pool is not a paged-KV tensor the OffloadingConnector
#                       moves; and attn-KV is negligible. Offload buys ~nothing for Qwen. Leave OFF.
#   * EAGER (PT_HPU_LAZY_MODE=0) — the PROVEN Qwen3.6 path (lazy = synStatus-26 on hybrid+fp8+vision).
#
# CO-RESIDENCE: util 0.08 -> ~10GB/card (3.7 weights + ~5.5 GDN state pool + ~1 overhead). max-num-seqs
#   is FREE concurrency (state pool is util-sized, not seq-sized) — crank it for more Qwen users at ~no
#   memory cost. Start Qwen AFTER GLM has grabbed its ~86GB, or size util against measured free mem.
# =================================================================================================
IMAGE=vllm-gaudi:next
MODEL_PATH=Qwen3.6-27B-FP8
SERVED_NAME=qwen36
# CO-RESIDENT: own port so it doesn't collide with GLM on 8000 (both --net=host). Real system hits
# GLM at :8000 and Qwen at :8001.
PORT=8001
MODEL_ENV="-e PT_HPU_LAZY_MODE=0 -e PT_HPU_WEIGHT_SHARING=0 -e VLLM_SKIP_WARMUP=true -e VLLM_ENGINE_ITERATION_TIMEOUT_S=1800 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 -e VLLM_DECODE_BS_BUCKET_MIN=1 -e VLLM_GRAPH_RESERVED_MEM=0.10 -e VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true"
# APC ON (do NOT set VLLM_CONTIGUOUS_PA). max-num-seqs high = free Qwen concurrency (state pool is util-sized).
# PRODUCTION 2026-07-06 (standalone full-box; Qwen and GLM switch since Gaudi can't co-tenant TP8):
# mml 262144 (Qwen's native 256K context), util 0.85 (owns all 8 cards when active) -> large GDN state
# pool = high concurrency (state pool is util-sized, O(1) in context). Keyless (API_KEY empty in
# common.env). fp8_inc KV + APC on the 16 full-attn layers. No CPU offload (GDN state isn't paged KV).
VLLM_ARGS="--quantization fp8 --kv-cache-dtype fp8_inc --tensor-parallel-size 8 --max-model-len 262144 --max-num-seqs 128 --gpu-memory-utilization 0.85 --block-size 128 --async-scheduling --enable-prefix-caching --trust-remote-code"
