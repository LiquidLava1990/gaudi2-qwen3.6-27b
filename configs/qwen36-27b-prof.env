# Qwen3.6-27B-FP8 — PROFILING serve = the SS champion config (dynamic_shapes=false, 39.1) + HPU torch
# profiler. VLLM_TORCH_PROFILER_DIR=/prof enables the /start_profile /stop_profile endpoints; vllm-gaudi
# captures ProfilerActivity.HPU (device ops w/ durations). We trace a bs=1 decode window to see where the
# per-token time actually goes (GDN vs attn vs GEMM vs collective vs sampler vs HOST-GAP) -> decides what's
# worth optimizing next. util 0.10 (profiler overhead headroom). EXTRA_MOUNTS maps /prof to a host dir.
IMAGE=vllm-gaudi:next
MODEL_PATH=Qwen3.6-27B-FP8
SERVED_NAME=qwen36-27b
EXTRA_MOUNTS="-v /tmp/qwen_prof:/prof"
MODEL_ENV="-e PT_HPU_LAZY_MODE=0 -e PT_HPU_WEIGHT_SHARING=0 -e VLLM_SKIP_WARMUP=true -e VLLM_T_COMPILE_DYNAMIC_SHAPES=false -e VLLM_TORCH_PROFILER_DIR=/prof -e VLLM_ENGINE_ITERATION_TIMEOUT_S=1800 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 -e VLLM_GRAPH_RESERVED_MEM=0.10 -e VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true"
VLLM_ARGS="--quantization fp8 --kv-cache-dtype fp8_inc --tensor-parallel-size 8 --max-model-len 2048 --max-num-seqs 16 --gpu-memory-utilization 0.10 --block-size 128 --async-scheduling --no-enable-prefix-caching --trust-remote-code"
