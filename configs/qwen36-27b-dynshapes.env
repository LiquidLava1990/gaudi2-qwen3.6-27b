# Qwen3.6-27B-FP8 — base champion (qwen36-27b.env) + VLLM_T_COMPILE_DYNAMIC_SHAPES=false ONLY.
# Clean A/B for the "static shapes = faster decode graph" lever (features.py default True = dynamic ON;
# =false forces static per-shape graphs, no dynamic guards -> faster steady-state decode, +5-10% SS claim).
# Distinct key -> own container + own /recipe_cache/qwen36-27b-dynshapes (avoids the stale-replay trap
# from flipping an env knob on the base key's warm cache). Everything else BYTE-IDENTICAL to base for a
# clean single-variable A/B: eager, fp8+fp8-KV, TP=8, util 0.04, max-num-seqs 16, ml 2048.
# GATE: coherent + decode SS vs base 33.1. (On-demand compile under SKIP_WARMUP adds first-token latency
# only; decode_agg/per_user reflect the static-graph speed.)
IMAGE=vllm-gaudi:next
MODEL_PATH=Qwen3.6-27B-FP8
SERVED_NAME=qwen36-27b
MODEL_ENV="-e PT_HPU_LAZY_MODE=0 -e PT_HPU_WEIGHT_SHARING=0 -e VLLM_SKIP_WARMUP=true -e VLLM_T_COMPILE_DYNAMIC_SHAPES=false -e VLLM_ENGINE_ITERATION_TIMEOUT_S=1800 -e VLLM_RPC_TIMEOUT=100000000 -e VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=3600 -e VLLM_DECODE_BS_BUCKET_MIN=1 -e VLLM_GRAPH_RESERVED_MEM=0.10 -e VLLM_HPU_LOG_STEP_CPU_FALLBACKS=true"
VLLM_ARGS="--quantization fp8 --kv-cache-dtype fp8_inc --tensor-parallel-size 8 --max-model-len 2048 --max-num-seqs 16 --gpu-memory-utilization 0.04 --block-size 128 --async-scheduling --no-enable-prefix-caching --trust-remote-code"
