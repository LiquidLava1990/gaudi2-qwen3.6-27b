# Qwen3.6-35B-A3B  (35B total / 3B active MoE, bf16, MULTIMODAL: vision + video)
# arch Qwen3_5MoeForConditionalGeneration. UNQUANTIZED -> stock vllm-gaudi unquantized MoE
# path (NO plugin, NO --quantization). 72G bf16 weights, fits across 8x96GB with room for KV.
MODEL_PATH=Qwen3.6-35B-A3B
SERVED_NAME=qwen36
# LAZY_MODE=0 (torch.compile) REQUIRED on the upstream-PyTorch-2.10 base image.
MODEL_ENV="-e PT_HPU_LAZY_MODE=0 -e PT_HPU_WEIGHT_SHARING=0 -e VLLM_ENGINE_ITERATION_TIMEOUT_S=900 -e VLLM_RPC_TIMEOUT=100000000"
# Multimodal: trust-remote-code for the Qwen3.5-VL processor. mm limits left at vLLM
# defaults for first bring-up; tune --limit-mm-per-prompt after text/vision verified.
VLLM_ARGS="--tensor-parallel-size 8 --enable-expert-parallel --max-model-len 32768 --max-num-seqs 64 --gpu-memory-utilization 0.9 --block-size 128 --async-scheduling --enable-prefix-caching --trust-remote-code"
